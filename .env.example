# All of these default to "localhost" in the scripts themselves --
# this file is only needed if you want to override one of them
# (e.g. pointing recv.py's rsync target or validate.py's Ollama
# server at a different machine later).

# recv.py -- RabbitMQ host AND the rsync target host (original script
# uses the same box for both).
CRIMSON_HOST=localhost
CRIMSON_REMOTE_USER=ubuntu
# CRIMSON_SSH_KEY_PATH=/root/.ssh/id_ed25519
# Was a single hardcoded 'add_central_server_path' shared by both rsync
# targets (a likely bug -- results/ and check/ would land in the same
# remote dir). Now split so they don't collide.
CRIMSON_REMOTE_RESULTS_PATH=crimson-central/results/
CRIMSON_REMOTE_CHECK_PATH=crimson-central/check/

# utils/screenshot.py -- was hardcoded to a machine-specific unpacked Chrome
# build. Defaults match the chromium/chromium-driver apt packages installed
# in the crimson-python-env image; only override if you installed Chrome
# somewhere else in a custom image.
# CRIMSON_CHROME_BINARY=/usr/bin/chromium
# CRIMSON_CHROMEDRIVER_PATH=/usr/bin/chromedriver

# send.py -- how long a filtered domain sits in cryptoscams_delay before
# RabbitMQ dead-letters it into cryptoscams for recv.py to pick up.
# Default matches the paper's 12-hour buffer (in milliseconds).
CRIMSON_QUEUE_DELAY_MS=43200000

# send.py / listen.py -- RabbitMQ host
RABBITMQ_HOST=localhost

# listen.py -- certstream-server-rust websocket endpoint
CERTSTREAM_HOST=localhost
CERTSTREAM_PORT=8080

# validate.py -- Ollama server
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3:70b

# crawler.py -- stage 6 runs wallet_browser (Crimson/vendor/wallet_browser):
# a Scrapling stealth browser driven by Claude through the Claude Code CLI.
# The container can't see a terminal login, so it needs a long-lived
# subscription token from `claude setup-token`. Nothing crawls without it.
CLAUDE_CODE_OAUTH_TOKEN=
# Claude Code model alias (sonnet / opus / haiku) or a full model ID
WALLET_BROWSER_MODEL=sonnet
# false = visible browser window (needs a display; won't work in Docker)
WALLET_BROWSER_HEADLESS=true
# Per-site crawl budget in seconds
WALLET_BROWSER_TIMEOUT=600
# Per-LLM-step (act/extract) budget in seconds
WALLET_BROWSER_STEP_TIMEOUT=240
# false = don't run Scrapling's Cloudflare solver; walled sites are recorded as BLOCKED
WALLET_BROWSER_SOLVE_CLOUDFLARE=true
# false = don't have Claude read image/math CAPTCHAs on signup/login forms
WALLET_BROWSER_SOLVE_CAPTCHA=true
